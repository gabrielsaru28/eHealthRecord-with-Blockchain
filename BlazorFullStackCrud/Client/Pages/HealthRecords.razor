@page "/healthrecords"

@*   Registered and Injected our HealthRecordService      *@

@inject NavigationManager NavigationManager
@inject IHealthRecordService HealthRecordService
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JSRuntime

@using Nethereum.Hex.HexConvertors.Extensions;
@using Nethereum.Web3;
@using Newtonsoft.Json;
@using System.Text;

@using Nethereum.Contracts;
@using Nethereum.Web3.Accounts;
@using Nethereum.Contracts.Extensions;

@*     Add the Authorized attribute for the Trusted Medical  Institution     *@


<PageTitle>Health Records</PageTitle>

<AuthorizeView>
    
    <NotAuthorized>
        <span> You're not authorized to see this.</span>
    </NotAuthorized>
    
    <Authorized>
        <span><b>Welcome Andrei Ionescu!</b></span>
        <br />
        <br />  
        <span><b><u>Being an employee from a medical institution, a trusted entity</u>, you're authorized to manage and put healthrecords to the Blockchain.</b></span>
        <p></p>
        <p></p>
    </Authorized>

</AuthorizeView>

<h3>Health Records</h3>

<table class="table">
    <thead>
        <tr>
            <th>Patient Id</th>
            <th>Patient Name</th>
            <th>Medical History</th>
            <th>Medications</th>
            <th>Allergy Name</th>
            <th>Signature</th>

            <th>Edit</th> <!-- For the button to edit or show -->
            <th>Sign</th> <!-- For the button to sign the record -->

        </tr>
    </thead>
       
    <tbody>
        @*
        For each loop where we would acces
        the HealthRecords form the WebAPI

        Here, it uploads on the UI the data from the HealthRecordService (and the HealthRecordService gets the data from the HealthRecordController)

        *@

        <!-- Loop through the HealthRecords and display them -->
        @foreach (var record in HealthRecordService.Records)
        {
            <tr>
                <td>@record.PatientId</td>
                <td>@record.PatientName</td>
                <td>@record.MedicalHistory</td>
                <td>@record.Medications</td>
                <td>@record.Allergies.AllergyName </td>
                <td>@record.Signature</td>

                <td>
                    <!-- Edit button -->
                    <button class="btn btn-primary" @onclick=" (() => ShowHealthRecord(record.PatientId))">
                        <i class="oi oi-pencil"></i>
                    </button>
                </td>

                @*
                    When the user clicks the "Sign" button, 
                    the component should call a method on the server-side BlockchainController, passing the ID of the selected health record as a parameter.
                *@
                <td>
                    <!-- Sign button -->
                    <!-- Triggers the signing process   --> 
                    <button class="btn btn-primary" @onclick="(() => SignHealthRecord(record.PatientId))">
                        @if (isLoading)
                        {
                            <i class="loading-animation"></i> <!-- Add the CSS class for the loading animation -->
                        }
                        else
                        {
                            <i class="oi oi-key"></i>
                        }
                    </button>

                    
                </td>

            </tr>
        }
    </tbody>
</table>

<button class="btn btn-primary" @onclick="CreateNewRecord">Create New Record</button>


@code {

    bool isLoading = false; // Used to show the loading animation

    protected override async Task OnInitializedAsync()
    {
        await HealthRecordService.GetHealthRecords();
    }

    void CreateNewRecord()
    {
        NavigationManager.NavigateTo("record");
    }

    void ShowHealthRecord(int id)
    {
        NavigationManager.NavigateTo($"record/{id}");
    }  

 
    /*
     * 
     * This method calls the SignHealthRecord method in the HealthRecordService, passing the ID of the selected health record as a parameter.
     * 
     */
    async Task SignHealthRecord(int id)
    {
        try
        {
            isLoading = true; // Set loading state to true


            // Call the SignHealthRecord method in the HealthRecordService
            var transactionHash = await HealthRecordService.SignHealthRecord(id);

            // Update the health record with the transaction hash
            var record = HealthRecordService.Records.FirstOrDefault(r => r.PatientId == id);
            if (record != null)
            {
                record.Signature = transactionHash;
            }
        }
        catch (Exception ex)
        {
            // Handle the error
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false; // Set loading state to false
        }
    }

}