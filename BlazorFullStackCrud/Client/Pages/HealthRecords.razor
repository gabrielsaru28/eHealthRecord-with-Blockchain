@page "/healthrecords"

@*   Registered and Injected our HealthRecordService      *@
@inject IHealthRecordService HealthRecordService
@inject NavigationManager NavigationManager
@using Nethereum.Hex.HexConvertors.Extensions;
@using Nethereum.Web3;


<PageTitle>Health Records</PageTitle>

<h3>Health Records</h3>

<table class="table">
    <thead>
        <tr>
            <th>Patient Id</th>
            <th>Patient Name</th>
            <th>Medical History</th>
            <th>Medications</th>
            <th>Allergy Name</th>

            <th></th> <!-- For the button to edit or show -->
            <th></th> <!-- For the button to sign the record -->

        </tr>
    </thead>
       
    <tbody>
        @*
        For each loop where we would acces
        the HealthRecords form the WebAPI

        Here, it uploads on the UI the data from the HealthRecordService (and the HealthRecordService gets the data from the HealthRecordController)
        *@

        <!-- Loop through the HealthRecords and display them -->
        @foreach (var record in HealthRecordService.Records)
        {
            <tr>
                <td>@record.PatientId</td>
                <td>@record.PatientName</td>
                <td>@record.MedicalHistory</td>
                <td>@record.Medications</td>
                <td>@record.Allergies.AllergyName </td>

                <td>
                    <!-- Edit button -->
                    <button class="btn btn-primary" @onclick=" (() => ShowHealthRecord(record.PatientId))">
                        <i class="oi oi-pencil"></i>
                    </button>
                </td>
                @*
            <td>
            <!-- Sign button -->
            <button class="btn btn-primary" @onclick="(() => SignHealthRecord(record.PatientId))">
            Semneaza
            </button>
            </td>*@

            </tr>
        }
    </tbody>



</table>
<button class="btn btn-primary" @onclick="CreateNewRecord">Create New Record</button>


@code {
    protected override async Task OnInitializedAsync()
    {
        await HealthRecordService.GetHealthRecords();
    }

    void ShowHealthRecord(int id)
    {
        NavigationManager.NavigateTo($"record/{id}");
    }


    void CreateNewRecord()
    {
        NavigationManager.NavigateTo("record");
    }
}