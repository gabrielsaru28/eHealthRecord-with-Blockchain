@*  For create  *@
@page "/record"            
 
@*  For edit    *@
@page "/record/{id:int}"   

@inject IHealthRecordService HealthRecordService
@if (Id == null)
{
    <PageTitle>Create a new Record</PageTitle>
    <h3>Create a new Record</h3>
}
else
{
    <PageTitle>Edit @record2.PatientName</PageTitle>
    <h3>Edit @record2.PatientName</h3>

}

<EditForm Model="record2" OnSubmit="HandleSubmit">
    
    
    <div>
        <label for="patientname">Patient Name</label>
        <InputText id="patientname" @bind-Value="record2.PatientName" class="form-control"></InputText>
    </div>

    <div>
        <label for="medicalhistory">Medical History</label>
        <InputText id="medicalhistory" @bind-Value="record2.MedicalHistory" class="form-control"></InputText>
    </div>

    <div>
        <label for="medications">Medications</label>
        <InputText id="medications" @bind-Value="record2.Medications" class="form-control"></InputText>
    </div>

    <div>
        <label for="allergies">Allergies</label>
        
        <InputSelect id="allergies"  @bind-Value="record2.AllergyId" class="form-select">

           <option value="@aList[0].AllergyId">You need to select!</option>
            @foreach(var allergy in aList)
            {
                <option value="@allergy.AllergyId">@allergy.AllergyName</option>
            }
        </InputSelect>
    </div>

    <br />
    
    <button type="submit" class="btn btn-primary">@btnText</button>
    <button type="button" class="btn btn-danger" @onclick="DeleteRecord">Delete Record</button>


</EditForm>


@code {
    [Parameter]
    public int? Id { get; set; }

    string btnText = string.Empty;

    HealthRecord record = new HealthRecord
    {
        Allergies = new Allergies()

    };

    List<Allergies> aList = new List<Allergies>();
    HealthRecordModel record2 = new HealthRecordModel();


    protected override async Task OnInitializedAsync()
    {
        btnText = Id == null ? "Save New Record" : "Update Record";
        await HealthRecordService.GetAllergies();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id == null)
        {
            // create a new record
            //record.Allergies = HealthRecordService.Allergies[0];
            //record.AllergyId = record.Allergies.AllergyId;
            
            var result = HealthRecordService.Allergies2;
            foreach (var iterator in result)
            {
                var allergiesAdd = new Allergies
                {
                    AllergyId = iterator.AllergyId,
                    AllergyName = iterator.AllergyName
                };
                aList.Add(allergiesAdd);
            }
        }
        else
        {
            record = await HealthRecordService.GetSingleHealthRecord((int)Id);
        }
    }

    /*
     * Method that handles the action when you press submit.
     * 
     */
    async Task HandleSubmit()
    {
        // If the Id of the created healthrecord data is NULL, which means is new created
        if(Id == null)
        {   
            // Then it creates the healthrecord and adds it to the database.
            await HealthRecordService.CreateRecord(record2);
        }
        // Otherwise
        else
        {   // It updates it.
            await HealthRecordService.UpdateRecord(record);
        }
    }

    /*
     * Method that activates when the button 'Delete Record' is pressed.
     * 
     */
    async Task DeleteRecord()
    {
        await HealthRecordService.DeleteRecord(record.PatientId);
    }
}
